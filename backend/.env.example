# Copy to backend/.env for local development. NEVER commit the real .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase project (Settings -> API)
SUPABASE_URL=https://tfcwyccbhspkxfttfefc.supabase.co
# Public publishable/anon key. Requests are made with the user's JWT so Row Level Security applies.
SUPABASE_ANON_KEY=sb_publishable_xxx
# Server-only secret key. Used ONLY to delete auth users when an account is deleted. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: inline JWKS JSON to skip fetching https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS=
# Optional: legacy HS256 JWT secret (only for projects still on symmetric keys)
SUPABASE_JWT_SECRET=

STORAGE_BUCKET=waste-images
AVATAR_BUCKET=avatars
SIGNED_URL_TTL_SECONDS=3600

# Comma-separated list of allowed browser origins, plus an optional regex for preview deployments
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=

MAX_UPLOAD_MB=4
PREDICT_RATE_PER_MINUTE=10
PREDICT_RATE_PER_DAY=300
# MODEL_DIR defaults to backend/model_artifacts
